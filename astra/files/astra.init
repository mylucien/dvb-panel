#!/bin/sh /etc/rc.common
# astra 面板服务
#
# 端口沿用 /etc/config/astra 的 port（默认 8000），
# frontend0 是独占的：要用 TVHeadend / MuMuDVB 时先把 enabled 关掉。

START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load astra

	local enabled port
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	config_get port main port 8000

	procd_open_instance
	procd_set_param command /usr/bin/astra-run "$port"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger astra
}

reload_service() {
	stop
	start
}
