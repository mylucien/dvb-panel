#!/bin/sh /etc/rc.common
# Astra: streaming server (+ event monitor for the LuCI interface)
#
# The port comes from /etc/config/astra (default 8000).
# A DVB frontend is exclusive: switch "enabled" off before using TVHeadend /
# MuMuDVB on the same tuner.

START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load astra

	local enabled port
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	config_get port main port 8000

	# Credentials used by luci-app-astra: created once, the cipher is computed
	# by astra itself. Must happen while astra is stopped (it rewrites astra.json).
	/usr/bin/ucode /usr/libexec/astra/provision || \
		logger -t astra "credential provisioning failed; the LuCI interface cannot sign in"

	procd_open_instance astra
	procd_set_param command /usr/bin/astra-run "$port"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# live adapter/stream state for LuCI (installed by luci-app-astra)
	# run through the interpreter: does not depend on the file's execute bit
	if [ -f /usr/libexec/astra/monitor ]; then
		procd_open_instance monitor
		procd_set_param command /usr/bin/ucode /usr/libexec/astra/monitor
		procd_set_param respawn 3600 5 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger astra
}

reload_service() {
	stop
	start
}
