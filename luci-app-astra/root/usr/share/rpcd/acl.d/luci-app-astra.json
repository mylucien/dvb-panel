{
	"luci-app-astra": {
		"description": "Grant access to Astra management",
		"read": {
			"ubus": {
				"luci.astra": [ "getStatus", "getState", "getDvbList", "query" ],
				"luci": [ "getInitList" ]
			},
			"uci": [ "astra" ]
		},
		"write": {
			"ubus": {
				"luci.astra": [ "control" ]
			},
			"file": {
				"/etc/init.d/astra": [ "exec" ]
			},
			"uci": [ "astra" ]
		}
	}
}
